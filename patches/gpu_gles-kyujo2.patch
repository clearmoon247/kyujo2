+/* Kyujo2: short messages (notices) drawn over the picture as a transparent layer, so the picture can still come straight from its surface. Before, a notice forced
+ * every picture through a read-back to game memory and an upload (a GPU stall per picture: on the Switch the battle's first seconds, when the cheat notice shows,
+ * crawled). The layer is premultiplied RGBA covering the whole picture; the render thread uploads it at the next presentation. */
+static pthread_mutex_t gOvMutex = PTHREAD_MUTEX_INITIALIZER;
+static unsigned char *gOvPending;                  /* new layer waiting for upload (guarded by gOvMutex) */
+static unsigned gOvPendingW, gOvPendingH;
+static int gOvChanged, gOvOn;                      /* gOvChanged: guarded by gOvMutex; gOvOn: render thread */
+static GLuint gOvTex, gOvProg;
+static GLint gOvLocScale;
+void gles_set_overlay(const unsigned char *rgba, unsigned w, unsigned h)
+{
+    unsigned char *copy = NULL;
+    if (rgba && w && h && (copy = (unsigned char *)malloc((size_t)w * h * 4u)) != NULL) memcpy(copy, rgba, (size_t)w * h * 4u);
+    pthread_mutex_lock(&gOvMutex);
+    free(gOvPending);
+    gOvPending = copy;
+    gOvPendingW = copy ? w : 0;
+    gOvPendingH = copy ? h : 0;
+    gOvChanged = 1;
+    pthread_mutex_unlock(&gOvMutex);
+}
+static void overlay_draw(float sx, float sy)
+{
+    pthread_mutex_lock(&gOvMutex);
+    if (gOvChanged) {
+        gOvChanged = 0;
+        gOvOn = gOvPending != NULL;
+        if (gOvOn) {
+            if (!gOvTex) {
+                glGenTextures(1, &gOvTex);
+                glBindTexture(GL_TEXTURE_2D, gOvTex);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+                glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+            }
+            glBindTexture(GL_TEXTURE_2D, gOvTex);
+            glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, (GLsizei)gOvPendingW, (GLsizei)gOvPendingH, 0, GL_RGBA, GL_UNSIGNED_BYTE, gOvPending);
+        }
+    }
+    pthread_mutex_unlock(&gOvMutex);
+    if (!gOvOn) return;
+    if (!gOvProg) {
+        static const char *vs =
+            "#version 300 es\n"
+            "uniform vec2 uScale;\n"
+            "out vec2 vUv;\n"
+            "void main() {\n"
+            "  vec2 p = vec2(float(gl_VertexID & 1), float((gl_VertexID >> 1) & 1));\n"
+            "  vUv = vec2(p.x, 1.0 - p.y);\n"
+            "  gl_Position = vec4((p * 2.0 - 1.0) * uScale, 0.0, 1.0);\n"
+            "}\n";
+        static const char *fs =
+            "#version 300 es\n"
+            "precision mediump float;\n"
+            "uniform sampler2D uOv;\n"
+            "in vec2 vUv;\n"
+            "out vec4 oCol;\n"
+            "void main() { oCol = texture(uOv, vUv); }\n";
+        GLuint v = compile(GL_VERTEX_SHADER, vs), f = compile(GL_FRAGMENT_SHADER, fs);
+        GLint ok = 0;
+        if (!v || !f) { gOvOn = 0; return; }
+        gOvProg = glCreateProgram();
+        glAttachShader(gOvProg, v);
+        glAttachShader(gOvProg, f);
+        glLinkProgram(gOvProg);
+        glGetProgramiv(gOvProg, GL_LINK_STATUS, &ok);
+        glDeleteShader(v);
+        glDeleteShader(f);
+        if (!ok) { glDeleteProgram(gOvProg); gOvProg = 0; gOvOn = 0; return; }
+        gOvLocScale = glGetUniformLocation(gOvProg, "uScale");
+        glUseProgram(gOvProg);
+        glUniform1i(glGetUniformLocation(gOvProg, "uOv"), 0);
+    }
+    glUseProgram(gOvProg);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, gOvTex);
+    glUniform2f(gOvLocScale, sx, sy);
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glDisable(GL_BLEND);
+    gl_check("overlay");
+}
