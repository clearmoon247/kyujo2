+/* ---- MBC3 real-time clock (Kyujo2) ----
+ * Registers 0x08-0x0C: seconds, minutes, hours, day bits 0-7, and day bit 8 | halt (0x40) | day carry (0x80). Writing 0 then 1 to
+ * 0x6000-0x7FFF copies the running clock into the readable registers. GB Tower sets and checks the clock while it saves; with the
+ * registers reading 0xFF its check never passed. The clock runs from the time of the last write while not halted. */
+static unsigned long long rtc_now(GbPak *p)
+{
+    unsigned long long total = p->rtc_seconds;
+    if (!p->rtc_halt) total += (host_now_ns() - p->rtc_base_ns) / 1000000000ULL;
+    if (total >= 512ULL * 86400ULL) { total %= 512ULL * 86400ULL; p->rtc_carry = 1; }
+    return total;
+}
+
+static void rtc_registers(GbPak *p, unsigned char out[5])
+{
+    unsigned long long t = rtc_now(p);
+    unsigned days = (unsigned)(t / 86400ULL);
+    out[0] = (unsigned char)(t % 60); out[1] = (unsigned char)(t / 60 % 60); out[2] = (unsigned char)(t / 3600 % 24);
+    out[3] = (unsigned char)(days & 0xFF);
+    out[4] = (unsigned char)(((days >> 8) & 1) | (p->rtc_halt ? 0x40 : 0) | (p->rtc_carry ? 0x80 : 0));
+}
+
+static void rtc_write(GbPak *p, int reg, unsigned char v)
+{
+    unsigned char r[5];
+    unsigned days;
+    rtc_registers(p, r);
+    switch (reg) {
+    case 0: r[0] = v % 60; break;
+    case 1: r[1] = v % 60; break;
+    case 2: r[2] = v % 24; break;
+    case 3: r[3] = v; break;
+    default: r[4] = v; p->rtc_halt = (v & 0x40) != 0; p->rtc_carry = (v & 0x80) != 0; break;
+    }
+    days = r[3] | ((r[4] & 1u) << 8);
+    p->rtc_seconds = (unsigned long long)days * 86400ULL + r[2] * 3600ULL + r[1] * 60ULL + r[0];
+    p->rtc_base_ns = host_now_ns();
+    p->rtc_latched[reg] = reg == 4 ? (unsigned char)(r[4] & 0xC1) : r[reg];
+}
