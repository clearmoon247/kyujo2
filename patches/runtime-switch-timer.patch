+#ifdef __SWITCH__
+static std::thread *switch_timer_thread;
+// The Homebrew loader unloads the program's code when it exits, so the timer thread must have ended by then: called
+// after the game has stopped (exited is set). The empty action wakes it from either wait.
+void ultramodern::stop_timer_thread() {
+    if (!switch_timer_thread || !switch_timer_thread->joinable()) return;
+    timer_context.action_queue.enqueue(RemoveTimerAction{});
+    switch_timer_thread->join();
+}
+#endif
+
 void ultramodern::init_timers(RDRAM_ARG1) {
+#ifdef __SWITCH__
+    // libnx cannot detach a thread: std::thread::detach throws, which ended the program as the game started. The
+    // thread object is kept instead, and joined by stop_timer_thread before the program exits.
+    switch_timer_thread = new std::thread{ timer_thread, PASS_RDRAM1 };
+    return;
+#endif
     timer_context.thread = std::thread{ timer_thread, PASS_RDRAM1 };
     timer_context.thread.detach();
 }
