+
+// Called after the game has stopped (exited is set, the event threads and the thread cleaner are joined).
+void ultramodern::terminate_game_threads() {
+    using namespace std::chrono_literals;
+    std::vector<UltraThreadContext*> waiting;
+    {
+        std::lock_guard lock{ live_threads_mutex };
+        terminating = true;
+        waiting.assign(live_threads.begin(), live_threads.end());
+    }
+    for (UltraThreadContext* context : waiting) {
+        context->running.signal();
+    }
+    // A thread that is not waiting (for example sleeping in a host call) ends when it next waits. Give them a moment;
+    // one that never ends is left alone rather than joined, so the exit cannot hang.
+    size_t left = waiting.size();
+    for (int i = 0; i < 200 && left; ++i) {
+        std::this_thread::sleep_for(5ms);
+        std::lock_guard lock{ live_threads_mutex };
+        left = live_threads.size();
+    }
+    std::vector<UltraThreadContext*> ended;
+    {
+        std::lock_guard lock{ live_threads_mutex };
+        ended.swap(ended_threads);
+    }
+    // Threads that ended before, and were not yet joined by the cleaner.
+    UltraThreadContext* queued;
+    while (deleted_threads.try_dequeue(queued)) {
+        ended.push_back(queued);
+    }
+    for (UltraThreadContext* context : ended) {
+        if (context->host_thread.joinable()) {
+            context->host_thread.join();
+        }
+        delete context;
+    }
+    std::fprintf(stderr, "Switch: ended %zu game threads, %zu still running\n", ended.size(), left);
+}
+#endif
