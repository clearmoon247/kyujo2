diff --git a/host_settings.c b/host_settings.c
index 957838b..d35af91 100644
--- a/host_settings.c
+++ b/host_settings.c
@@ -418,6 +418,9 @@ int host_settings_save(const HostSettings *s, const char *path)
 #ifdef _WIN32
     if (!MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) { fprintf(stderr, "kyujo: settings: cannot replace '%s'\n", path); return 1; }   /* rename() would refuse to replace */
 #else
+#ifdef __SWITCH__
+    remove(path);                                                   /* the SD card's rename() does not replace an existing file */
+#endif
     if (rename(tmp, path) != 0) { fprintf(stderr, "kyujo: settings: cannot replace '%s'\n", path); return 1; }
 #endif
     return 0;
